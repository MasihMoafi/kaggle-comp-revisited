, exist_ok=True)
    try:
        proc = subprocess.run([sys.executable, "-m", "kaggle", *args], capture_output=True, text=True, env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Kaggle command timed out"}
    out, err = proc.stdout.strip(), proc.stderr.strip()
    if proc.returncode:
        return {"ok": False, "error": (err or out or f"exit {proc.returncode}")[-8000:], "exit_code": proc.returncode}
    try:
        value = json.loads(out) if out else None
    except json.JSONDecodeError:
        value = out
    return {"ok": True, "result": value}


def content(value: Any, error: bool = False) -> dict[str, Any]:
    return {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False, indent=2, default=str)}], "isError": error}


