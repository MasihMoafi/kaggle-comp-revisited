de replay.", "inputSchema": {"type": "object", "properties": {"episode_id": {"type": "integer", "minimum": 1}}, "required": ["episode_id"], "additionalProperties": False}, "annotations": {"title": "Get replay", "readOnlyHint": True, "destructiveHint": False, "openWorldHint": True}},
